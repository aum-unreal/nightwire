{
  "name": "nightwire",
  "version": "0.9.2",
  "description": "OLED Markdown reader for Android with direct file opening, full-text search and graph navigation",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "vendor": "node scripts/vendor.cjs",
    "typecheck": "node node_modules/typescript/bin/tsc -p classifier/tsconfig.json",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/browser.cjs",
    "build": "./build.sh",
    "test:navigation": "node tests/navigation.cjs",
    "test:themes": "node tests/themes.cjs",
    "test:fonts": "node tests/fonts.cjs",
    "test:terminal": "node tests/terminal.cjs",
    "test:cyberdeck": "node tests/cyberdeck.cjs",
    "test:blackout": "node tests/blackout.cjs",
    "test:index-themes": "node tests/index-themes.cjs",
    "test:nav-dock": "node tests/nav-dock.cjs",
    "test:font-rack": "node tests/font-rack.cjs",
    "test:graph-board": "node tests/graph-board.cjs",
    "test:font-sync": "node tests/font-sync.cjs",
    "test:word-anchor": "node tests/word-anchor.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@highlightjs/cdn-assets": "11.12.0",
    "animejs": "4.5.0",
    "dompurify": "3.4.16",
    "force-graph": "1.52.0",
    "lucide": "1.50.0",
    "markdown-it": "15.0.2",
    "minisearch": "7.2.0"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
