<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.nightwire" android:versionCode="18" android:versionName="0.9.3">
  <uses-permission android:name="android.permission.INTERNET"/>
  <application android:label="Nightwire" android:icon="@drawable/ic_launcher" android:theme="@style/AppTheme" android:allowBackup="false" android:usesCleartextTraffic="false" android:hardwareAccelerated="true">
    <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop" android:windowSoftInputMode="adjustResize" android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
      <intent-filter><action android:name="android.intent.action.VIEW"/><category android:name="android.intent.category.DEFAULT"/><category android:name="android.intent.category.BROWSABLE"/><data android:scheme="content"/><data android:scheme="file"/><data android:mimeType="text/markdown"/><data android:mimeType="text/x-markdown"/><data android:mimeType="text/plain"/><data android:mimeType="application/markdown"/><data android:mimeType="application/x-markdown"/><data android:mimeType="text/vnd.daringfireball.markdown"/><data android:mimeType="application/octet-stream"/></intent-filter>
      <intent-filter><action android:name="android.intent.action.SEND"/><category android:name="android.intent.category.DEFAULT"/><data android:mimeType="text/*"/><data android:mimeType="application/octet-stream"/></intent-filter>
      <intent-filter><action android:name="android.intent.action.SEND_MULTIPLE"/><category android:name="android.intent.category.DEFAULT"/><data android:mimeType="text/*"/><data android:mimeType="application/octet-stream"/></intent-filter>
    </activity>
  </application>
</manifest>
